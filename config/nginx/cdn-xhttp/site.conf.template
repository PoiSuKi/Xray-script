# Managed by Xray-script CDN-XHTTP mode
server {
    listen 80;
    __IPV6_LISTEN_80__
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/_zerossl;
        default_type text/plain;
        access_log off;
        add_header Cache-Control "no-store";
    }

    location / {
        return 301 https://$host$request_uri;
    }

    access_log off;
}

server {
    listen 443 ssl;
    __IPV6_LISTEN_443__
    http2 on;
    server_name __DOMAIN__;

    root __WEB_ROOT__;
    index index.html;
    client_header_timeout 5m;

    ssl_certificate __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:CDN_XHTTP_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location ^~ __XHTTP_PATH__ {
        limit_except GET POST OPTIONS {
            deny all;
        }

        access_log off;
        client_max_body_size 0;
        client_body_timeout 5m;
        keepalive_timeout 5m;
        grpc_socket_keepalive on;
        grpc_read_timeout 1h;
        grpc_send_timeout 1h;
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        grpc_set_header X-Forwarded-Proto $scheme;
        grpc_pass unix:__SOCKET_PATH__;
        error_page 502 503 504 =404 /__cdn_xhttp_not_found;
    }

    location = /__cdn_xhttp_not_found {
        internal;
        return 404;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    access_log off;
}
